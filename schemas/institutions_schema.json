{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset 01 - Judicial Institutions",
  "type": "object",
  "required": [
    "institution_id",
    "court_name",
    "court_type",
    "jurisdiction",
    "province",
    "official_source",
    "source_url",
    "last_verified",
    "validation_status"
  ],
  "properties": {
    "institution_id": {"type": "string", "pattern": "^INST-[A-Z0-9-]+$"},
    "court_name": {"type": "string", "minLength": 3},
    "court_type": {"type": "string", "enum": ["Mahkamah Agung", "Tingkat Banding", "Tingkat Pertama", "Pengadilan Khusus"]},
    "jurisdiction": {"type": "string", "enum": ["Umum", "Agama", "Tata Usaha Negara", "Militer", "Mahkamah Agung"]},
    "province": {"type": ["string", "null"]},
    "district": {"type": ["string", "null"]},
    "official_source": {"type": "string"},
    "source_url": {"type": "string", "format": "uri"},
    "last_verified": {"type": "string", "format": "date"},
    "validation_status": {"type": "string", "enum": ["VERIFIED", "DERIVED", "UNVERIFIED"]}
  },
  "additionalProperties": false
}
